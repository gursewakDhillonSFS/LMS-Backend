# Server Port
PORT=3288

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lms

# Security
JWT_SECRET=your-jwt-secret-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email / Brevo Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-sender-email@gmail.com
BREVO_SENDER_NAME=SkillBuild
FRONTEND_URL=http://localhost:3000

# Stripe Payments (Optional / Production)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==============================================================================
# OPTIONAL: Course Translation Service Configuration
# ==============================================================================
# The system works automatically with 0 configuration using built-in free
# open-source providers (MyMemory & LibreTranslate).
#
# If you run the local NLLB-200 microservice (scripts/nllb_service.py):
# NLLB_API_URL=http://localhost:5005/translate
#
# If you host your own private LibreTranslate instance:
# LIBRETRANSLATE_URL=https://your-libretranslate-domain/translate
